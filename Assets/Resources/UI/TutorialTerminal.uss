/* Protocol Interface — 教程校准 UI（非 Debug Terminal） */

.protocol-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.protocol-skip-top {
    position: absolute;
    top: 12px;
    right: 12px;
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 16px;
    color: var(--neon-muted);
    background-color: rgba(10, 10, 15, 0.55);
    border-width: 1px;
    border-color: rgba(110, 140, 158, 0.35);
    -unity-font-style: bold;
}

.protocol-skip-top:hover {
    color: var(--neon-ice);
    border-color: rgba(0, 232, 255, 0.45);
}

.protocol-card {
    position: absolute;
    left: 16px;
    right: 16px;
    min-height: 0;
    max-width: 560px;
    align-self: center;
    background-color: rgba(10, 10, 15, 0.88);
    border-width: 1px;
    border-color: rgba(0, 232, 255, 0.38);
    padding: 18px 20px 16px;
    flex-direction: column;
}

.protocol-card-action {
    padding-top: 10px;
    padding-bottom: 8px;
    background-color: rgba(10, 10, 15, 0.72);
    border-color: rgba(0, 232, 255, 0.28);
}

.protocol-anchor-bottom {
    bottom: 22%;
    align-self: center;
}

.protocol-anchor-top {
    top: 14%;
    align-self: center;
}

.protocol-anchor-skills {
    bottom: 18%;
    align-self: center;
}

.protocol-anchor-combo {
    top: 18%;
    left: 12px;
    right: auto;
    width: 320px;
}

.protocol-anchor-center {
    top: 38%;
    align-self: center;
}

.protocol-anchor-slot-top {
    top: 4%;
    align-self: center;
    max-width: 520px;
}

.protocol-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: rgb(0, 232, 255);
}

.protocol-corner-tl { left: -1px; top: -1px; border-left-width: 2px; border-top-width: 2px; }
.protocol-corner-tr { right: -1px; top: -1px; border-right-width: 2px; border-top-width: 2px; }
.protocol-corner-bl { left: -1px; bottom: -1px; border-left-width: 2px; border-bottom-width: 2px; }
.protocol-corner-br { right: -1px; bottom: -1px; border-right-width: 2px; border-bottom-width: 2px; }

.protocol-header {
    margin-bottom: 6px;
}

.protocol-progress {
    font-size: 15px;
    color: rgba(0, 232, 255, 0.75);
    letter-spacing: 1.2px;
}

.protocol-title {
    font-size: 30px;
    color: var(--neon-white);
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.protocol-description {
    font-size: 22px;
    color: var(--neon-ice);
    white-space: normal;
    margin-bottom: 8px;
}

.protocol-hint {
    font-size: 20px;
    color: rgb(0, 232, 255);
    letter-spacing: 0.5px;
    padding: 8px 12px;
    margin-bottom: 4px;
    background-color: rgba(0, 232, 255, 0.06);
    border-width: 1px;
    border-color: rgba(0, 232, 255, 0.28);
    white-space: normal;
}

.protocol-hint-pulse {
    border-color: rgb(0, 232, 255);
    color: rgb(255, 255, 255);
}

.protocol-btn-primary {
    align-self: flex-end;
    height: 40px;
    min-width: 80px;
    margin-top: 6px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    background-color: rgb(0, 232, 255);
    border-width: 0;
}

.protocol-btn-primary:hover {
    background-color: rgb(120, 255, 255);
}

.protocol-btn-ghost {
    height: 40px;
    min-width: 80px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 17px;
    color: var(--neon-muted);
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(110, 140, 158, 0.45);
}

.protocol-confirm {
    font-size: 17px;
    color: rgb(0, 232, 255);
    -unity-font-style: bold;
    margin-top: 4px;
    opacity: 0;
}

.protocol-confirm-show {
    opacity: 1;
}

.skip-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 10, 15, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

.skip-overlay-visible {
    display: flex;
}

.skip-panel {
    width: 88%;
    max-width: 400px;
    padding: 20px 18px;
    background-color: rgba(10, 10, 15, 0.95);
    border-width: 1px;
    border-color: rgba(0, 232, 255, 0.4);
    flex-direction: column;
}

.skip-title {
    font-size: 26px;
    color: var(--neon-white);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.skip-body {
    font-size: 20px;
    color: var(--neon-muted);
    margin-bottom: 14px;
    white-space: normal;
}

.skip-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.skip-actions .protocol-btn-ghost {
    margin-left: 8px;
}
