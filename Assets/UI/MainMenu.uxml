<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="ProtocolNeonTheme.uss" />
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="MainContainer" class="main-container">
        <ui:VisualElement class="vignette-overlay" picking-mode="Ignore" />
        <ui:VisualElement class="scanline-overlay" picking-mode="Ignore" />

        <!-- 主菜单 · Protocol Terminal（ASCII CRT 风格） -->
        <ui:VisualElement name="MainMenuPanel" class="menu-panel home-panel terminal-home">
            <ui:VisualElement class="home-topbar terminal-topbar">
                <ui:Label text="SYS:ONLINE" class="term-status" />
                <ui:VisualElement class="home-topbar-spacer" />
                <ui:Button name="BtnSettings" text="SETTINGS" class="term-nav" />
                <ui:Label text="CR" class="home-credits-key" />
                <ui:Label name="MainCreditsLabel" text="999,999" class="home-credits-label" />
            </ui:VisualElement>

            <ui:VisualElement class="term-stage">
                <ui:Label text="回弹协议" class="term-title-cn" />
                <ui:Label text="REBOUND" class="term-title-en" />
                <ui:Label name="TermSubtitle" text="PROTOCOL" class="term-subtitle" />

                <ui:Button name="BtnEndless" text="" class="term-cta endless-btn">
                    <ui:Label name="TermCtaLabel" text="[  SPACE / CLICK TO RUN  ]" class="term-cta-label" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="term-secondary-row">
                    <ui:Button name="BtnCampaign" text="战役" class="term-link campaign-btn" />
                    <ui:Label text="/" class="term-sep" picking-mode="Ignore" />
                    <ui:Button name="BtnTutorial" text="协议校准" class="term-link" />
                    <ui:Label text="/" class="term-sep" picking-mode="Ignore" />
                    <ui:Button name="BtnLoadout" text="战前配置" class="term-link" />
                    <ui:Label text="/" class="term-sep" picking-mode="Ignore" />
                    <ui:Button name="BtnShop" text="商店" class="term-link" />
                </ui:VisualElement>

                <ui:VisualElement class="term-meta-block">
                    <ui:Label name="HomeLoadoutLine" text="LOADOUT  标准弹珠  |  Q:斩杀连锁  E:护盾格挡" class="term-meta-line" />
                    <ui:Button name="BtnHomeEditLoadout" text="[ EDIT ]" class="term-edit-link" />
                    <ui:Label name="HomeTelemetryLine" text="WAVE —  ·  COMBO —  ·  BOSS —  ·  PROTO 1" class="term-meta-line term-meta-dim" />
                </ui:VisualElement>

                <!-- 兼容旧刷新逻辑：隐藏字段仍由 MainMenuController 写入 -->
                <ui:VisualElement class="term-compat-hidden" picking-mode="Ignore">
                    <ui:Label name="HomeBallName" text="标准弹珠" />
                    <ui:Label name="HomeBallDesc" text="均衡核心 · 适合全模式" />
                    <ui:Label name="HomeSkill0Name" text="斩杀连锁" />
                    <ui:Label name="HomeSkill1Name" text="护盾格挡" />
                    <ui:Label name="HomeStatWave" text="—" />
                    <ui:Label name="HomeStatCombo" text="—" />
                    <ui:Label name="HomeStatBosses" text="—" />
                    <ui:Label name="HomeStatProtocols" text="1" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="home-footer terminal-footer">
                <ui:Label text="> AWAITING OPERATOR INPUT_" class="home-footer-hint" picking-mode="Ignore" />
                <ui:VisualElement class="home-footer-actions">
                    <ui:Button name="BtnFooterSettings" text="设置" class="menu-btn home-quiet btn-outline-muted" />
                    <ui:Button name="BtnQuit" text="退出" class="menu-btn home-quiet btn-outline-muted quit-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="CampaignPanel" class="panel" style="display: none; flex-direction: row;">
            <ui:VisualElement class="campaign-left">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                    <ui:Label text="星 区 选 择" class="header-title" />
                    <ui:Button name="BtnBack" text="◀ 返回主页" class="back-btn" />
                </ui:VisualElement>
                <ui:ScrollView name="LevelScrollView" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="level-scroll" />
            </ui:VisualElement>

            <ui:VisualElement class="campaign-right neon-panel">
                <ui:Label name="DetailStage" text="STAGE 01" class="detail-stage" />
                <ui:Label name="DetailTitle" text="石巨像之怒" class="detail-title" />
                <ui:VisualElement class="divider" />
                <ui:Label name="DetailDesc" text="石巨像苏醒！它在场地上方徘徊，不断派遣装甲兵压迫底线。利用两侧的反射棱镜，可以形成在 BOSS 身后的高频反弹狂暴连穿！" class="detail-desc" />

                <ui:VisualElement style="margin-top: 40px;">
                    <ui:Label name="DetailBoss" text="核心目标: 石巨像" class="detail-info highlight-info" />
                    <ui:Label name="DetailPower" text="推荐战力: 100" class="detail-info" />
                    <ui:Label name="DetailScore" text="最高得分: 0" class="detail-info detail-score" />
                </ui:VisualElement>

                <ui:VisualElement name="RunConfigSummary" class="run-config-summary">
                    <ui:Label text="当前配置" class="summary-header" />
                    <ui:Label name="SummaryBallLabel" text="标准弹珠" class="summary-line" />
                    <ui:Label name="SummarySkillsLabel" text="斩杀连锁 · 护盾格挡" class="summary-line" />
                    <ui:Button name="BtnEditLoadout" text="修改配置" class="summary-edit-btn" />
                </ui:VisualElement>

                <ui:Button name="BtnLaunch" text="协 议 启 动" class="launch-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 战前配置 -->
        <ui:VisualElement name="LoadoutPanel" class="panel loadout-panel" style="display: none; position: relative;">
            <ui:VisualElement class="loadout-header">
                <ui:Button name="BtnLoadoutBack" text="◀ 返回" class="back-btn" />
                <ui:Label text="战 前 配 置" class="loadout-title" />
                <ui:VisualElement class="loadout-header-spacer" />
            </ui:VisualElement>

            <ui:VisualElement class="loadout-body">
                <ui:VisualElement name="BallColumn" class="loadout-column ball-column">
                    <ui:Label text="弹珠选择" class="column-title" />
                    <ui:VisualElement name="BallPreviewHost" class="ball-preview-host">
                        <ui:VisualElement name="BallPreviewOrb" class="ball-preview-orb" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ball-pager-row">
                        <ui:Button name="BtnBallPrev" text="◀" class="ball-nav-btn" />
                        <ui:VisualElement name="BallPagerDots" class="ball-pager-dots" />
                        <ui:Button name="BtnBallNext" text="▶" class="ball-nav-btn" />
                    </ui:VisualElement>
                    <ui:Label name="BallLockHint" text="" class="ball-lock-hint" style="display: none;" />
                    <ui:Label name="BallNameLabel" text="标准弹珠" class="ball-name-label" />
                    <ui:Label name="BallDescLabel" text="基础均衡弹珠，适合各种局面。" class="ball-desc-label" />
                    <ui:Button name="BtnEquipBall" text="装备此弹珠" class="hangar-equip-btn" />
                </ui:VisualElement>

                <ui:VisualElement name="SkillColumn" class="loadout-column skill-column">
                    <ui:Label text="绑定技能 · 随弹珠固定" class="column-title" />
                    <ui:VisualElement name="SkillSlotRow" class="skill-slot-row">
                        <ui:VisualElement name="SkillSlot0" class="skill-slot skill-slot-readonly">
                            <ui:VisualElement name="SlotIcon" class="skill-slot-icon" />
                            <ui:Label name="SlotSkillName" text="斩杀连锁" class="skill-slot-name" />
                            <ui:Label name="SlotKeyHint" text="Q" class="skill-slot-key" />
                            <ui:Label name="SlotCooldown" text="CD 12s" class="skill-slot-cd" />
                            <ui:Label name="SlotMode" text="瞄准" class="skill-slot-mode" />
                        </ui:VisualElement>
                        <ui:VisualElement name="SkillSlot1" class="skill-slot skill-slot-readonly">
                            <ui:VisualElement name="SlotIcon" class="skill-slot-icon" />
                            <ui:Label name="SlotSkillName" text="护盾格挡" class="skill-slot-name" />
                            <ui:Label name="SlotKeyHint" text="E" class="skill-slot-key" />
                            <ui:Label name="SlotCooldown" text="CD 15s" class="skill-slot-cd" />
                            <ui:Label name="SlotMode" text="即时" class="skill-slot-mode" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="技能由所选弹珠决定，不可自由更换。" class="loadout-skill-note" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 协议商店 -->
        <ui:VisualElement name="ShopPanel" class="panel shop-panel" style="display: none;">
            <ui:VisualElement class="shop-header">
                <ui:Button name="BtnShopBack" text="◀ 返回" class="back-btn" />
                <ui:Label text="协 议 商 店" class="shop-title" />
                <ui:Label name="ShopCreditsLabel" text="协议币 999999" class="shop-credits-label" />
            </ui:VisualElement>

            <ui:VisualElement class="shop-tabs">
                <ui:Button name="BtnTabDirect" text="直购弹珠" class="shop-tab shop-tab-active" />
                <ui:Button name="BtnTabCrate" text="协议宝箱" class="shop-tab" />
            </ui:VisualElement>

            <ui:VisualElement name="ShopDirectTab" class="shop-tab-content">
                <ui:ScrollView name="DirectOffersScroll" horizontal-scroller-visibility="Hidden" class="shop-scroll">
                    <ui:VisualElement name="DirectOffersList" class="shop-offer-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="ShopCrateTab" class="shop-tab-content" style="display: none;">
                <ui:VisualElement class="crate-card neon-panel">
                    <ui:Label text="PROTOCOL CRATE" class="crate-eyebrow" />
                    <ui:Label text="协议宝箱" class="crate-title" />
                    <ui:Label text="消耗协议币随机解锁弹珠。重复弹珠折算为协议币。" class="crate-desc" />

                    <ui:VisualElement class="crate-preview" picking-mode="Ignore">
                        <ui:VisualElement class="crate-glow-ring" picking-mode="Ignore" />
                        <ui:VisualElement class="crate-body-idle" picking-mode="Ignore">
                            <ui:VisualElement class="crate-lid-idle" picking-mode="Ignore" />
                            <ui:VisualElement class="crate-seal-idle" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label name="CrateCostLabel" text="单次开启 · 150 协议币" class="crate-cost" />
                    <ui:Label name="CratePityLabel" text="" class="crate-pity" />
                    <ui:Button name="BtnOpenCrate" text="开启宝箱" class="crate-open-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="CrateResultPopup" class="crate-result-popup" style="display: none;">
                <ui:VisualElement name="CrateVignette" class="crate-vignette-host" picking-mode="Ignore" />
                <ui:VisualElement name="CrateRayHost" class="crate-ray-host" picking-mode="Ignore" />
                <ui:VisualElement name="CrateScreenFlash" class="crate-screen-flash" picking-mode="Ignore" />
                <ui:VisualElement name="CrateLightPillar" class="crate-light-pillar" picking-mode="Ignore" />
                <ui:VisualElement name="CrateSparkLayer" class="crate-spark-layer" picking-mode="Ignore" />

                <ui:VisualElement name="CrateRitualStage" class="crate-ritual-stage">
                    <ui:Label name="CrateRitualStatus" text="" class="crate-ritual-status" />

                    <ui:VisualElement name="CrateAssembly" class="crate-assembly">
                        <ui:VisualElement class="crate-ground-shadow" picking-mode="Ignore" />
                        <ui:VisualElement name="CrateGlow" class="crate-glow" picking-mode="Ignore" />
                        <ui:VisualElement name="CrateStack" class="crate-stack">
                            <ui:VisualElement name="CrateLid" class="crate-lid" picking-mode="Ignore">
                                <ui:VisualElement class="crate-lid-face" picking-mode="Ignore" />
                                <ui:VisualElement class="crate-lid-band" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="CrateBody" class="crate-body" picking-mode="Ignore">
                                <ui:VisualElement class="crate-body-face" picking-mode="Ignore" />
                                <ui:VisualElement class="crate-body-band" picking-mode="Ignore" />
                                <ui:VisualElement name="CrateSeal" class="crate-seal" picking-mode="Ignore" />
                                <ui:VisualElement name="CrateCore" class="crate-core" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="CrateRevealBlock" class="crate-reveal-block" style="display: none;">
                        <ui:VisualElement class="crate-reveal-card neon-panel">
                            <ui:Label name="CrateRarityLabel" text="RARE" class="crate-rarity-label" />
                            <ui:VisualElement name="CrateRevealOrb" class="crate-reveal-orb" />
                            <ui:Label name="CrateResultTitle" text="获得弹珠" class="crate-result-title" />
                            <ui:Label name="CrateResultBody" text="" class="crate-result-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button name="BtnCrateResultOk" text="收 下" class="crate-result-ok" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 设置 -->
        <ui:VisualElement name="SettingsPanel" class="panel settings-panel neon-panel" style="display: none;">
            <ui:VisualElement class="settings-header">
                <ui:Button name="BtnSettingsBack" text="◀ 返回" class="back-btn" />
                <ui:Label text="设  置" class="settings-title" />
            </ui:VisualElement>
            <ui:ScrollView class="settings-scroll">
                <ui:Label text="音频" class="section-title settings-section" />
                <ui:VisualElement class="settings-row">
                    <ui:Label text="主音量" class="settings-label" />
                    <ui:Slider name="SliderMaster" low-value="0" high-value="1" value="0.8" class="settings-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label text="音效" class="settings-label" />
                    <ui:Slider name="SliderSfx" low-value="0" high-value="1" value="0.8" class="settings-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label text="音乐" class="settings-label" />
                    <ui:Slider name="SliderMusic" low-value="0" high-value="1" value="0.8" class="settings-slider" />
                </ui:VisualElement>
                <ui:Label text="操作说明" class="section-title settings-section" />
                <ui:Label name="SettingsHintPc" class="settings-hint" text="PC：Esc 暂停 · 右键斩击瞄准 · Q/E 技能" />
                <ui:Label name="SettingsHintMobile" class="settings-hint" text="移动端：右上角暂停 · 技能按钮松手确认瞄准" />
                <ui:Label text="音量滑条等功能即将推出" class="settings-stub-note" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
