/* Live game controls and settlement modals */
.gameplay-overlay { display: none; background-color: transparent; }
.gameplay-claim { position: absolute; left: 490px; top: 1030px; width: 174px; height: 72px; display: none; }
.gameplay-hint { left: 70px; top: 1120px; width: 580px; height: 62px; font-size: 20px; }
.gameplay-combo { left: 70px; top: 1182px; width: 580px; height: 30px; font-size: 24px; }
.gameplay-combo-rule { left: 70px; top: 1214px; width: 580px; height: 56px; font-size: 17px; }
.reel-window.reel-selected { border-width: 2px; border-color: #ffc775; }
.reel-window.reel-selectable-hint > .lock-line { background-color: #76ffd9; }
.debuff-modal, .tower-choice { position: absolute; left: 10%; top: 25%; width: 80%; padding: 24px; background-color: rgba(2, 9, 13, .98); border-width: 2px; border-color: #42d8f5; display: none; }
.debuff-modal-title, .tower-choice-title { font-size: 32px; color: #bdf9ff; }
.debuff-line, .tower-choice-hint { font-size: 24px; white-space: normal; margin-top: 12px; margin-bottom: 12px; color: #dbfaff; }
.tower-choice-buttons { flex-direction: row; justify-content: center; }
.select-btn, .debuff-continue-btn { font-size: 26px; padding: 12px; margin: 8px; background-color: #102e37; color: #dcfcff; border-width: 1px; border-color: #42d8f5; }
