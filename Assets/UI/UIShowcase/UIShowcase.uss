/* UIShowcase dock — Cyberpunk Neon chrome over panel previews */

:root {
    --neon-cyan: rgb(0, 232, 255);
    --neon-ice: rgb(200, 245, 255);
    --neon-fuchsia: rgb(255, 64, 200);
    --neon-yellow: rgb(255, 214, 96);
    --neon-muted: rgb(110, 140, 158);
    --neon-panel: rgba(3, 7, 18, 0.92);
}

.showcase-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
}

.dock {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 10px 12px;
    background-color: var(--neon-panel);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 232, 255, 0.4);
}

.dock-title {
    font-size: 11px;
    color: var(--neon-ice);
    letter-spacing: 2px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    text-shadow: 0 0 10px rgba(0, 232, 255, 0.45);
}

.dock-group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
}

.dock-sep {
    width: 1px;
    height: 22px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(0, 255, 255, 0.35);
    flex-shrink: 0;
}

.dock-btn {
    height: 28px;
    margin-right: 6px;
    margin-bottom: 2px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--neon-cyan);
    background-color: rgba(0, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.55);
    border-radius: 0;
    transition-duration: 0.12s;
}

.dock-btn:hover {
    background-color: rgba(0, 255, 255, 0.16);
    border-color: rgb(0, 255, 255);
}

.dock-btn:active {
    translate: 1px -1px;
    color: var(--neon-fuchsia);
    border-color: var(--neon-fuchsia);
}

.dock-btn.dock-active {
    color: rgb(0, 0, 0);
    background-color: rgb(0, 255, 255);
    border-color: rgb(0, 255, 255);
}

.dock-accent {
    color: var(--neon-yellow);
    border-color: rgba(255, 255, 0, 0.55);
    background-color: rgba(255, 255, 0, 0.05);
}

.dock-accent:hover {
    background-color: rgba(255, 255, 0, 0.14);
    border-color: rgb(255, 255, 0);
}

.dock-accent.dock-active {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 0);
    border-color: rgb(255, 255, 0);
}

.dock-hint {
    margin-left: auto;
    font-size: 10px;
    color: var(--neon-muted);
    letter-spacing: 1px;
    flex-shrink: 0;
}
