.lab-root { flex-grow: 1; background-color: #05070a; overflow: hidden; }
.stage { position: absolute; width: 1536px; height: 1024px; transform-origin: 0% 0%; }
Label { color: #bdf9ff; -unity-text-align: middle-center; white-space: normal; }
.reel-window { overflow: hidden; }
.live-button { margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); color: #eafdff; font-size: 28px; -unity-font-style: bold; transition-property: background-color, color; transition-duration: 0.15s; }
.live-button:hover, .live-button:focus { background-color: rgba(93, 242, 255, 0.12); color: white; }
.live-button:active { background-color: rgba(93, 242, 255, 0.22); }
.live-button:disabled { color: #67939a; }
.test-button { font-size: 13px; background-color: rgba(3, 9, 14, 0.9); border-width: 1px; border-color: #244550; border-radius: 3px; }
.test-button:hover, .test-button:focus { border-color: #5df2ff; }
