.main-container {
    width: 100%;
    height: 100%;
    /* 赛博朋克深蓝渐变底色 */
    background-color: rgb(10, 15, 25);
}

.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.title {
    font-size: 150px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255, 100, 0, 0.5);
    text-shadow: 0 5px 0 rgba(255, 100, 0, 0.5);
}

.subtitle {
    font-size: 40px;
    color: rgb(0, 240, 255);
    margin-bottom: 100px;
    letter-spacing: 20px;
}

.button-group {
    width: 500px;
}

.menu-btn {
    height: 100px;
    font-size: 45px;
    -unity-font-style: bold;
    margin-bottom: 30px;
    background-color: rgba(30, 40, 60, 0.8);
    color: rgb(180, 190, 210);
    border-width: 3px;
    border-color: rgb(100, 110, 130);
    border-radius: 10px;
    transition: scale 0.2s ease-out-back, background-color 0.2s;
}

.menu-btn:hover {
    background-color: rgba(60, 80, 120, 0.9);
    scale: 1.05;
}

.endless-btn {
    color: rgb(0, 240, 255);
    border-color: rgb(0, 240, 255);
}

.campaign-btn {
    color: rgb(255, 0, 128);
    border-color: rgb(255, 0, 128);
}

/* 战役面板 */
.campaign-left {
    flex-grow: 1;
    padding: 60px;
    padding-left: 100px;
}

.campaign-right {
    width: 600px; /* 增大右侧详情板的宽度 */
    background-color: rgba(20, 25, 40, 0.95);
    border-left-width: 4px;
    border-left-color: rgb(0, 240, 255);
    padding: 50px;
    justify-content: flex-start;
}

.header-title {
    font-size: 60px;
    color: rgb(255, 0, 128);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 0, 128, 0.5);
}

.back-btn {
    font-size: 35px;
    color: white;
    background-color: transparent;
    border-width: 0;
    transition: scale 0.2s;
}

.back-btn:hover {
    scale: 1.1;
    color: rgb(0, 240, 255);
}

.level-scroll {
    flex-grow: 1;
    margin-top: 60px;
}

.detail-stage {
    font-size: 35px;
    color: rgb(0, 240, 255);
    margin-top: 20px;
    -unity-font-style: bold;
}

.detail-title {
    font-size: 70px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.divider {
    height: 3px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 40px;
}

.detail-desc {
    font-size: 32px;
    color: rgb(200, 210, 220);
    white-space: normal;
    flex-grow: 1;
    -unity-text-align: upper-left;
}

.detail-info {
    font-size: 35px;
    color: white;
    margin-bottom: 20px;
}

.highlight-info {
    color: rgb(255, 0, 128);
    -unity-font-style: bold;
}

.launch-btn {
    height: 120px;
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(255, 245, 0);
    background-color: rgba(255, 245, 0, 0.15);
    border-width: 4px;
    border-color: rgb(255, 245, 0);
    border-radius: 15px;
    margin-top: 40px;
    transition: scale 0.15s, background-color 0.15s;
}

.launch-btn:hover {
    scale: 1.05;
    background-color: rgba(255, 245, 0, 0.4);
}

/* 卡片样式 */
.level-card {
    width: 440px;
    height: 640px;
    margin-right: 60px;
    background-color: rgba(30, 45, 70, 0.85); /* 调亮卡片底色 */
    border-width: 3px;
    border-color: rgba(0, 240, 255, 0.3);
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    transition: scale 0.2s ease-out-back, border-color 0.2s;
    overflow: hidden;
}

.level-card:hover {
    border-color: rgb(0, 240, 255);
    scale: 1.05;
    background-color: rgba(45, 65, 100, 0.95);
}

.card-deco {
    position: absolute;
    top: 0;
    width: 100%;
    height: 15px;
    background-color: rgb(0, 240, 255);
}

.card-num {
    font-size: 35px;
    color: rgb(0, 240, 255);
    margin-bottom: 30px;
    -unity-font-style: bold;
}

.card-name {
    font-size: 55px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.card-stars {
    font-size: 40px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
}
