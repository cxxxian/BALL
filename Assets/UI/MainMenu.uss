.main-container {
    width: 100%;
    height: 100%;
    /* 赛博朋克深蓝渐变底色 */
    background-color: rgb(10, 15, 25);
}

.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.title {
    font-size: 100px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
    margin-bottom: 13px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 100, 0, 0.5);
    text-shadow: 0 3px 0 rgba(255, 100, 0, 0.5);
}

.subtitle {
    font-size: 27px;
    color: rgb(0, 240, 255);
    margin-bottom: 67px;
    letter-spacing: 13px;
}

.button-group {
    width: 333px;
}

.menu-btn {
    height: 67px;
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    background-color: rgba(30, 40, 60, 0.8);
    color: rgb(180, 190, 210);
    border-width: 2px;
    border-color: rgb(100, 110, 130);
    border-radius: 7px;
    transition: background-color 0.2s, border-color 0.2s;
}

.menu-btn:hover {
    background-color: rgba(60, 80, 120, 0.9);
    border-color: rgb(220, 230, 255);
}

.endless-btn {
    color: rgb(0, 240, 255);
    border-color: rgb(0, 240, 255);
}

.campaign-btn {
    color: rgb(255, 0, 128);
    border-color: rgb(255, 0, 128);
}

/* 战役面板 */
.campaign-left {
    flex-grow: 1;
    padding: 40px;
    padding-left: 67px;
}

.campaign-right {
    width: 400px; /* 增大右侧详情板的宽度 */
    background-color: rgba(20, 25, 40, 0.95);
    border-left-width: 3px;
    border-left-color: rgb(0, 240, 255);
    padding: 33px;
    justify-content: flex-start;
}

.header-title {
    font-size: 40px;
    color: rgb(255, 0, 128);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 0, 128, 0.5);
}

.back-btn {
    font-size: 23px;
    color: white;
    background-color: transparent;
    border-width: 0;
    transition: color 0.2s;
}

.back-btn:hover {
    color: rgb(0, 240, 255);
}

.level-scroll {
    flex-grow: 1;
    margin-top: 40px;
}

.detail-stage {
    font-size: 23px;
    color: rgb(0, 240, 255);
    margin-top: 13px;
    -unity-font-style: bold;
}

.detail-title {
    font-size: 47px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.divider {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 27px;
}

.detail-desc {
    font-size: 21px;
    color: rgb(200, 210, 220);
    white-space: normal;
    flex-grow: 1;
    -unity-text-align: upper-left;
}

.detail-info {
    font-size: 23px;
    color: white;
    margin-bottom: 13px;
}

.highlight-info {
    color: rgb(255, 0, 128);
    -unity-font-style: bold;
}

.launch-btn {
    height: 80px;
    font-size: 33px;
    -unity-font-style: bold;
    color: rgb(255, 245, 0);
    background-color: rgba(255, 245, 0, 0.15);
    border-width: 3px;
    border-color: rgb(255, 245, 0);
    border-radius: 10px;
    margin-top: 27px;
    transition: background-color 0.15s, border-color 0.15s;
}

.launch-btn:hover {
    background-color: rgba(255, 245, 0, 0.4);
    border-color: rgb(255, 255, 180);
}

/* 卡片样式 */
.level-card {
    width: 293px;
    height: 427px;
    margin-right: 40px;
    background-color: rgba(30, 45, 70, 0.85); /* 调亮卡片底色 */
    border-width: 2px;
    border-color: rgba(0, 240, 255, 0.3);
    border-radius: 13px;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, background-color 0.2s;
    overflow: hidden;
}

.level-card:hover {
    border-color: rgb(0, 240, 255);
    background-color: rgba(45, 65, 100, 0.95);
}

.card-deco {
    position: absolute;
    top: 0;
    width: 100%;
    height: 10px;
    background-color: rgb(0, 240, 255);
}

.card-num {
    font-size: 23px;
    color: rgb(0, 240, 255);
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.card-name {
    font-size: 37px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 27px;
}

.card-stars {
    font-size: 27px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
}

.loadout-btn {
    color: rgb(220, 230, 255);
    border-color: rgb(160, 175, 210);
}

.run-config-summary {
    margin-top: 24px;
    padding: 16px;
    background-color: rgba(15, 25, 45, 0.85);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.35);
    border-radius: 8px;
}

.summary-header {
    font-size: 19px;
    color: rgb(0, 240, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.summary-line {
    font-size: 17px;
    color: rgb(210, 220, 235);
    margin-bottom: 5px;
}

.summary-edit-btn {
    margin-top: 8px;
    height: 37px;
    font-size: 17px;
    color: rgb(0, 240, 255);
    background-color: rgba(0, 240, 255, 0.08);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.45);
    border-radius: 5px;
}

.loadout-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 27px 37px;
    position: relative;
}

.loadout-drag-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.loadout-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 19px;
}

.loadout-title {
    font-size: 35px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
}

.loadout-status-host {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    min-width: 120px;
    min-height: 21px;
}

.loadout-status-spinner {
    width: 15px;
    height: 15px;
    margin-right: 7px;
    border-width: 2px;
    border-color: rgba(0, 240, 255, 0.2);
    border-top-color: rgb(0, 240, 255);
    border-right-color: rgb(0, 240, 255);
    border-radius: 7px;
    flex-shrink: 0;
    display: none;
}

.loadout-status-host.loadout-status-saving .loadout-status-spinner {
    display: flex;
}

.loadout-status {
    font-size: 17px;
}

.loadout-status-ok {
    color: rgb(80, 220, 140);
}

.loadout-status-saving-text {
    color: rgb(0, 240, 255);
}

.loadout-status-warn {
    color: rgb(255, 120, 100);
}

.loadout-body {
    flex-direction: row;
    flex-grow: 1;
}

.loadout-column {
    flex-direction: column;
}

.ball-column {
    width: 34%;
    padding-right: 24px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.12);
}

.skill-column {
    flex-grow: 1;
    padding-left: 24px;
}

.column-title {
    font-size: 21px;
    color: rgb(0, 240, 255);
    -unity-font-style: bold;
    margin-bottom: 13px;
}

.column-subtitle {
    font-size: 17px;
    color: rgb(180, 195, 220);
    margin-top: 11px;
    margin-bottom: 8px;
}

.ball-preview-host {
    height: 147px;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 18, 32, 0.9);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.25);
    border-radius: 11px;
    margin-bottom: 11px;
}

.ball-preview-orb {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(80, 200, 255);
}

.ball-pager-dots {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.ball-pager-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0.25);
}

.ball-pager-dot-active {
    background-color: rgb(0, 240, 255);
}

.ball-name-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.ball-desc-label {
    font-size: 16px;
    color: rgb(190, 200, 215);
    white-space: normal;
    margin-bottom: 13px;
}

.ball-stat-line {
    font-size: 16px;
    color: rgb(170, 185, 205);
    margin-bottom: 4px;
}

.skill-slot-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 5px;
}

.skill-slot {
    flex-grow: 1;
    padding: 12px;
    background-color: rgba(20, 30, 50, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    min-height: 100px;
}

.skill-slot-drop-hover {
    border-color: rgb(255, 245, 0);
    background-color: rgba(255, 245, 0, 0.08);
}

.skill-slot-empty {
    border-color: rgba(0, 240, 255, 0.35);
    border-style: dashed;
}

.skill-drag-source {
    opacity: 0.45;
}

.skill-slot-icon {
    width: 9px;
    height: 32px;
    border-radius: 3px;
    margin-bottom: 7px;
    background-color: rgb(255, 80, 100);
}

.skill-slot-name {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
}

.skill-slot-key {
    font-size: 15px;
    color: rgb(0, 240, 255);
    margin-top: 4px;
}

.skill-slot-cd {
    font-size: 15px;
    color: rgb(180, 190, 210);
    margin-top: 3px;
}

.skill-slot-mode {
    font-size: 13px;
    color: rgb(150, 165, 190);
    margin-top: 3px;
}

.skill-library-draggable {
    cursor: link;
}

.skill-drag-ghost {
    position: absolute;
    width: 112px;
    min-height: 61px;
    padding: 7px 8px;
    background-color: rgba(18, 28, 48, 0.94);
    border-width: 1px;
    border-color: rgb(255, 245, 0);
    border-radius: 7px;
}

.skill-drag-ghost-stripe {
    height: 4px;
    border-radius: 2px;
    margin-bottom: 5px;
}

.skill-drag-ghost-name {
    font-size: 15px;
    color: white;
    -unity-font-style: bold;
}

.skill-drag-ghost-meta {
    font-size: 11px;
    color: rgb(0, 240, 255);
    margin-top: 3px;
}

.skill-library-scroll {
    max-height: 147px;
    margin-bottom: 11px;
}

.skill-library {
    flex-direction: row;
    flex-wrap: wrap;
}

.skill-library-card {
    width: 120px;
    min-height: 73px;
    margin-right: 9px;
    margin-bottom: 9px;
    padding: 8px;
    background-color: rgba(25, 35, 55, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 7px;
}

.skill-library-selected {
    border-color: rgb(255, 245, 0);
}

.skill-library-equipped {
    opacity: 0.72;
}

.skill-library-locked {
    opacity: 0.45;
}

.skill-lock-tag {
    font-size: 11px;
    color: rgb(140, 155, 180);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.skill-library-stripe {
    height: 4px;
    border-radius: 2px;
    margin-bottom: 7px;
}

.skill-library-name {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    white-space: normal;
}

.skill-library-badge {
    font-size: 12px;
    color: rgb(80, 220, 140);
    margin-top: 5px;
}

.skill-detail-card {
    padding: 11px 13px;
    background-color: rgba(12, 20, 36, 0.95);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.25);
    border-radius: 7px;
}

.skill-detail-title {
    font-size: 19px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.skill-detail-body {
    font-size: 15px;
    color: rgb(200, 210, 225);
    white-space: normal;
}
