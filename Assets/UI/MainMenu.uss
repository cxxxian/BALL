/* StyleKit · Cyberpunk Neon → Unity UITK
   Ref: https://www.stylekit.top/zh/styles/cyberpunk-neon */

:root {
    --neon-bg: rgb(6, 10, 18);
    --neon-panel: rgb(3, 7, 18);
    --neon-panel-elevated: rgb(8, 12, 24);
    /* 战场青白主轴 */
    --neon-cyan: rgb(0, 232, 255);
    --neon-ice: rgb(200, 245, 255);
    --neon-white: rgb(236, 248, 255);
    /* 层次：品红点缀 + 琥珀数值 */
    --neon-fuchsia: rgb(255, 64, 200);
    --neon-yellow: rgb(255, 214, 96);
    --neon-green: rgb(0, 232, 255);
    --neon-red: rgb(255, 72, 96);
    --neon-text: rgb(236, 248, 255);
    --neon-muted: rgb(110, 140, 158);
    --neon-border: rgba(0, 232, 255, 0.32);
    --neon-border-strong: rgba(120, 240, 255, 0.55);
    --neon-radius: 0;
    --neon-fast: 0.12s;
}

.main-container {
    width: 100%;
    height: 100%;
    background-color: rgba(10, 10, 15, 0);
}

.vignette-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Textures/ui_vignette.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 8, 20, 0.18);
}

.scanline-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Textures/ui_scanlines.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 20, 40, 0.04);
    opacity: 0.35;
}

.grid-overlay {
    display: none;
}

.neon-glow-text {
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.4);
}

.neon-panel {
    background-color: var(--neon-panel);
    border-width: 1px;
    border-color: var(--neon-border);
    border-radius: var(--neon-radius);
}

.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

/* ── 主菜单 Protocol Terminal ── */
.menu-panel,
.home-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

.terminal-home {
    background-color: rgba(2, 6, 14, 0.4);
}

.terminal-topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 16px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 232, 255, 0.22);
    background-color: rgba(4, 10, 22, 0.55);
}

.term-status {
    font-size: 20px;
    color: var(--neon-cyan);
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    text-shadow: 0 0 14px rgba(0, 232, 255, 0.55);
}

.term-nav {
    height: 40px;
    margin-right: 16px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--neon-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.term-nav:hover {
    color: var(--neon-ice);
    text-shadow: 0 0 10px rgba(120, 240, 255, 0.55);
}

.term-stage {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 24px 32px;
    overflow: hidden;
}

.term-title-cn {
    font-size: 52px;
    color: rgba(140, 230, 255, 0.82);
    letter-spacing: 14px;
    margin-bottom: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 16px rgba(0, 200, 255, 0.35);
}

.term-title-en {
    font-size: 90px;
    color: var(--neon-ice);
    letter-spacing: 12px;
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    -unity-text-align: middle-center;
    text-shadow: 0 0 28px rgba(0, 232, 255, 0.7);
}

.term-subtitle {
    font-size: 30px;
    letter-spacing: 10px;
    margin-bottom: 52px;
    color: var(--neon-cyan);
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    -unity-text-align: middle-center;
    text-shadow: 0 0 18px rgba(255, 64, 200, 0.35);
}

.term-cta {
    height: 72px;
    width: auto;
    min-width: 560px;
    max-width: 900px;
    margin-bottom: 32px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    align-items: center;
    justify-content: center;
}

.term-cta > .unity-button__text {
    display: none;
}

.term-cta-label {
    font-size: 28px;
    color: var(--neon-white);
    letter-spacing: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    -unity-text-align: middle-center;
    text-shadow: 0 0 18px rgba(0, 232, 255, 0.65);
}

.term-cta:hover .term-cta-label {
    color: var(--neon-ice);
    text-shadow: 0 0 24px rgba(120, 240, 255, 0.9);
}

.term-secondary-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 36px;
}

.term-link {
    height: 44px;
    min-width: auto;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 28px;
    letter-spacing: 3px;
    color: rgba(160, 230, 255, 0.78);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-font-style: bold;
}

.term-link:hover {
    color: var(--neon-fuchsia);
    text-shadow: 0 0 12px rgba(255, 64, 200, 0.55);
}

.term-sep {
    margin-left: 6px;
    margin-right: 6px;
    font-size: 24px;
    color: rgba(80, 120, 150, 0.75);
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.term-meta-block {
    flex-direction: column;
    align-items: center;
    max-width: 960px;
}

.term-meta-line {
    font-size: 22px;
    color: rgba(170, 220, 240, 0.72);
    letter-spacing: 1px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.term-meta-dim {
    color: rgba(110, 140, 158, 0.95);
    font-size: 18px;
}

.term-edit-link {
    height: 36px;
    margin-bottom: 12px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 17px;
    letter-spacing: 2px;
    color: rgba(0, 232, 255, 0.9);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    text-shadow: 0 0 10px rgba(0, 232, 255, 0.4);
}

.term-edit-link:hover {
    color: var(--neon-white);
    text-shadow: 0 0 14px rgba(255, 64, 200, 0.5);
}

.term-compat-hidden {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
}

.terminal-footer {
    border-top-color: rgba(0, 232, 255, 0.18);
}

.terminal-footer .home-footer-hint {
    font-size: 17px;
    color: rgba(0, 232, 255, 0.55);
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    text-shadow: 0 0 8px rgba(0, 232, 255, 0.25);
}

.home-topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 18px 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 232, 255, 0.2);
    background-color: rgba(5, 10, 20, 0.72);
}

.home-status-chip,
.home-credits-chip {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.28);
    background-color: rgb(0, 16, 28);
    flex-shrink: 0;
}

.home-live-dot {
    width: 7px;
    height: 7px;
    margin-right: 8px;
    background-color: var(--neon-cyan);
    border-radius: 1px;
    flex-shrink: 0;
}

.home-status-text {
    font-size: 16px;
    color: var(--neon-muted);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.home-topbar-spacer {
    flex-grow: 1;
    min-width: 12px;
}

.home-top-nav {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 8px;
}

.home-nav-link {
    height: 38px;
    margin-right: 4px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--neon-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-image: none;
    text-shadow: none;
    transition-duration: 0.12s;
    transition-property: color, translate;
}

.home-nav-link:hover {
    color: var(--neon-cyan);
    text-shadow: 0 0 6px rgba(0, 255, 255, 0.4);
}

.home-nav-link:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
}

.home-credits-key {
    font-size: 17px;
    color: rgba(0, 232, 255, 0.55);
    letter-spacing: 2px;
    margin-right: 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.home-credits-label {
    font-size: 20px;
    color: var(--neon-yellow);
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    text-shadow: 0 0 10px rgba(255, 214, 96, 0.4);
}

/* 加宽内容区并水平居中，左右对称 */
.home-hero-row {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 36px 48px 24px;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.home-hero-stage {
    width: 100%;
    max-width: 1560px;
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 0;
    min-width: 0;
    overflow: visible;
}

/* HTML grid-template-columns: 1.15fr / 0.85fr · gap 36
   UITK：flex-basis 0 + min-width 0，避免侧栏被内容 min-content 撑破比例 */
.home-hero-copy {
    flex-grow: 115;
    flex-shrink: 1;
    flex-basis: 0%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    max-width: none;
    width: auto;
    margin-right: 36px;
    margin-bottom: 0;
    overflow: visible;
}

.home-eyebrow {
    font-size: 16px;
    color: var(--neon-fuchsia);
    letter-spacing: 3px;
    margin-bottom: 14px;
    padding-top: 0;
    text-shadow: 0 0 8px rgba(255, 0, 255, 0.35);
    overflow: visible;
    flex-shrink: 0;
    align-self: flex-start;
}

.home-brand-title {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 18px;
    overflow: visible;
    flex-shrink: 0;
    align-self: flex-start;
}

.home-brand-cn {
    font-size: 96px;
    color: var(--neon-cyan);
    -unity-font-style: bold;
    letter-spacing: 5px;
    margin: 0;
    margin-bottom: 8px;
    padding: 0;
    height: auto;
    min-height: 0;
    text-shadow: 0 0 14px rgba(0, 255, 255, 0.35);
    white-space: nowrap;
    overflow: visible;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.home-brand-en {
    font-size: 18px;
    color: rgba(180, 240, 255, 0.72);
    letter-spacing: 6px;
    overflow: visible;
    margin-top: 0;
    flex-shrink: 0;
}

.home-lede {
    font-size: 20px;
    color: rgba(190, 210, 230, 0.82);
    white-space: normal;
    max-width: 640px;
    margin-bottom: 28px;
    -unity-text-align: upper-left;
    overflow: visible;
    flex-shrink: 0;
    align-self: flex-start;
}

/* CTA 随左栏加宽 */
.home-cta-stack {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 640px;
    margin-bottom: 18px;
    overflow: visible;
    flex-shrink: 0;
    align-self: flex-start;
}

.home-cta-stack > .neon-glow-host {
    width: 100%;
    max-width: 640px;
    margin-right: 0;
    margin-bottom: 12px;
    align-self: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: visible;
}

.home-cta-stack > .neon-glow-host > .home-cta {
    width: 100%;
}

.home-cta-stack > .home-cta {
    margin-bottom: 12px;
}

.home-cta-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    padding-left: 18px;
    padding-right: 18px;
    overflow: visible;
}

.home-cta-kicker {
    min-width: 120px;
    margin-right: 12px;
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(0, 0, 0);
    opacity: 0.55;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.home-cta-label {
    flex-grow: 1;
    font-size: 24px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
}

.home-cta-arrow {
    font-size: 26px;
    margin-left: 8px;
    opacity: 0.7;
    color: rgb(0, 0, 0);
    flex-shrink: 0;
}

.home-cta-magenta .home-cta-kicker,
.home-cta-magenta .home-cta-label,
.home-cta-magenta .home-cta-arrow,
.menu-btn.home-cta-magenta .home-cta-kicker,
.menu-btn.home-cta-magenta .home-cta-label,
.menu-btn.home-cta-magenta .home-cta-arrow {
    color: rgb(255, 255, 255);
}

.menu-btn.home-cta-primary .home-cta-kicker,
.menu-btn.home-cta-primary .home-cta-label,
.menu-btn.home-cta-primary .home-cta-arrow {
    color: rgb(3, 16, 24);
}

.home-secondary-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    overflow: visible;
    flex-shrink: 0;
    align-self: flex-start;
}

.home-secondary-row > .neon-glow-host {
    margin-right: 8px;
    margin-bottom: 0;
    align-self: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
}

.home-hero-side {
    flex-grow: 85;
    flex-shrink: 1;
    flex-basis: 0%;
    width: auto;
    min-width: 0;
    max-width: none;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    margin-bottom: 0;
    min-height: 0;
    height: auto;
    overflow: hidden;
}

.home-side-card {
    padding: 14px 16px;
    margin-bottom: 14px;
    background-color: rgb(4, 10, 20);
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.28);
    overflow: hidden;
    width: 100%;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.home-card-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    min-width: 0;
    overflow: visible;
}

.home-card-head-label {
    font-size: 15px;
    color: rgba(0, 242, 255, 0.75);
    letter-spacing: 2px;
    -unity-font-style: bold;
    flex-shrink: 1;
    white-space: nowrap;
}

.home-pill {
    padding: 4px 9px;
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.45);
    color: var(--neon-cyan);
    font-size: 12px;
    letter-spacing: 1px;
    flex-shrink: 0;
}

.home-pill-dim {
    color: var(--neon-muted);
    border-color: rgba(156, 163, 175, 0.35);
}

.home-ball-preview {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    width: 100%;
    overflow: visible;
    min-width: 0;
}

.home-ball-orb {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-right: 14px;
    flex-shrink: 0;
    background-color: rgb(0, 200, 224);
    border-width: 1px;
    border-color: rgba(180, 255, 255, 0.7);
}

.home-ball-meta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    overflow: visible;
}

.home-ball-name {
    font-size: 20px;
    color: rgb(232, 247, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: nowrap;
}

.home-ball-desc {
    font-size: 15px;
    color: var(--neon-muted);
    margin-top: 4px;
    white-space: normal;
}

.home-skill-row {
    flex-direction: row;
    margin-bottom: 10px;
    width: 100%;
    min-width: 0;
    overflow: visible;
}

.home-skill-chip {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.22);
    background-color: rgb(0, 16, 28);
    min-width: 0;
    overflow: visible;
}

.home-skill-key {
    margin-right: 8px;
    padding: 4px 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(3, 16, 24);
    background-color: var(--neon-cyan);
    flex-shrink: 0;
}

.home-skill-name {
    font-size: 16px;
    color: rgb(215, 238, 248);
    white-space: normal;
    min-width: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.home-link-edit {
    height: 38px;
    padding-left: 0;
    padding-right: 0;
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--neon-fuchsia);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    transition-duration: 0.12s;
    transition-property: color, translate;
}

.home-link-edit:hover {
    color: rgb(255, 140, 255);
    text-shadow: 0 0 8px rgba(255, 0, 255, 0.4);
}

.home-link-edit:active {
    translate: 2px -1px;
}

.home-stat-grid {
    flex-direction: column;
}

.home-stat-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.home-stat {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    padding: 10px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.16);
    background-color: rgb(0, 12, 22);
    overflow: visible;
}

.home-stat-end {
    margin-right: 0;
}

.home-stat-label {
    font-size: 13px;
    color: var(--neon-muted);
    letter-spacing: 1px;
    margin-bottom: 6px;
    white-space: nowrap;
}

.home-stat-value {
    font-size: 32px;
    color: var(--neon-cyan);
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.3);
}

.home-log-card {
    margin-bottom: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.home-boot-line {
    font-size: 15px;
    color: rgba(150, 200, 210, 0.85);
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.home-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 14px 28px 20px;
    border-top-width: 1px;
    border-top-color: rgba(0, 255, 255, 0.12);
    max-width: 100%;
}

.home-footer-hint {
    font-size: 15px;
    color: rgba(0, 242, 255, 0.55);
    letter-spacing: 2px;
    flex-grow: 1;
}

.home-footer-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    overflow: visible;
}

.home-footer-actions > .neon-glow-host {
    margin-left: 8px;
    margin-right: 0;
    align-self: center;
}

.home-footer-actions > .menu-btn {
    margin-left: 8px;
}

/* ── 按钮基类 / CTA / NeonHoverGlow ── */
.neon-glow-host {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    overflow: visible;
    margin-right: 12px;
}

/* 基础 menu-btn（NeonHoverGlow 挂载目标） */
.menu-btn {
    height: 36px;
    min-width: auto;
    width: auto;
    max-width: none;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    margin-right: 0;
    margin-bottom: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-width: 1px;
    border-radius: 0;
    background-image: none;
    overflow: visible;
    transition-duration: 0.12s;
    transition-property: background-color, border-color, color, translate;
    transition-timing-function: ease-out;
    -unity-text-align: middle-center;
}

/* 主 CTA：对齐 HTML .btn padding 14px 18px ≈ 48px 高 · 宽由 .home-cta-stack max 420 约束 */
.home-cta {
    height: 64px;
    width: 100%;
    max-width: 640px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    align-self: stretch;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 24px;
    letter-spacing: 3px;
    border-radius: 2px;
    -unity-text-align: middle-left;
    overflow: visible;
}

.home-cta > .unity-button__text {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.home-cta-primary {
    color: rgb(3, 16, 24);
    background-color: rgb(0, 255, 255);
    border-color: rgba(180, 255, 255, 0.85);
    text-shadow: 0 0 6px rgba(0, 255, 255, 0.3);
}

.home-cta-primary:hover {
    color: rgb(3, 16, 24);
    background-color: rgb(184, 255, 255);
    border-color: rgb(200, 255, 255);
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.45);
}

.home-cta-primary:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    background-color: rgb(0, 255, 255);
    border-color: var(--neon-fuchsia);
}

.home-cta-magenta {
    color: rgb(255, 255, 255);
    background-color: rgb(36, 8, 28);
    border-color: rgba(255, 0, 200, 0.85);
    text-shadow: 0 0 5px rgba(255, 0, 200, 0.3);
}

.home-cta-magenta:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(56, 12, 42);
    border-color: rgb(255, 80, 220);
    text-shadow: 0 0 7px rgba(255, 0, 200, 0.45);
}

.home-cta-magenta:active {
    translate: 2px -1px;
    color: var(--neon-cyan);
    background-color: rgb(36, 8, 28);
    border-color: var(--neon-cyan);
}

.home-ghost {
    height: 46px;
    width: auto;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--neon-cyan);
    background-color: rgb(0, 20, 36);
    border-color: rgba(0, 255, 255, 0.4);
    text-shadow: none;
    flex-grow: 0;
    flex-shrink: 0;
}

.home-ghost:hover {
    color: rgb(160, 255, 255);
    border-color: var(--neon-cyan);
    background-color: rgb(0, 28, 48);
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.3);
}

.home-ghost:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    border-color: var(--neon-fuchsia);
}

.home-quiet {
    height: 48px;
    font-size: 18px;
    padding-left: 16px;
    padding-right: 16px;
    letter-spacing: 2px;
    color: var(--neon-muted);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(156, 163, 175, 0.28);
    text-shadow: none;
}

.home-quiet:hover {
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(0, 0, 0, 0);
    text-shadow: none;
}

.home-quiet:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    border-color: var(--neon-fuchsia);
}

/* 主 CTA：实心青块 + 微外发光（保留给 NeonHoverGlow / 其它面板） */
.btn-jack {
    color: rgb(0, 0, 0);
    background-color: rgb(0, 255, 255);
    border-color: rgb(0, 255, 255);
    text-shadow: 0 0 6px rgba(0, 255, 255, 0.35);
}

.btn-jack:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(80, 255, 255);
    border-color: rgb(180, 255, 255);
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.5);
}

.btn-jack:active {
    translate: 2px -1px;
    color: rgb(255, 0, 255);
    background-color: transparent;
    border-color: rgb(255, 0, 255);
    text-shadow: 0 0 6px rgba(255, 0, 255, 0.45);
}

/* 描边按钮：VIEW_DEMO 微发光 */
.btn-outline-magenta {
    color: rgb(255, 0, 255);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(255, 0, 255);
    text-shadow: 0 0 5px rgba(255, 0, 255, 0.35);
}

.btn-outline-magenta:hover {
    color: rgb(255, 140, 255);
    background-color: rgba(255, 0, 255, 0.06);
    border-color: rgb(255, 100, 255);
    text-shadow: 0 0 7px rgba(255, 0, 255, 0.5);
}

.btn-outline-magenta:active {
    translate: 2px -1px;
    color: rgb(0, 255, 255);
    background-color: transparent;
    border-color: rgb(0, 255, 255);
}

.btn-outline-cyan {
    color: rgb(0, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 255, 255, 0.75);
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.3);
}

.btn-outline-cyan:hover {
    color: rgb(140, 255, 255);
    background-color: rgba(0, 255, 255, 0.06);
    border-color: rgb(0, 255, 255);
    text-shadow: 0 0 7px rgba(0, 255, 255, 0.5);
}

.btn-outline-cyan:active {
    translate: 2px -1px;
    color: rgb(255, 0, 255);
    background-color: transparent;
    border-color: rgb(255, 0, 255);
}

.btn-outline-yellow {
    color: rgb(255, 255, 0);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 255, 0, 0.7);
    text-shadow: 0 0 5px rgba(255, 255, 0, 0.3);
}

.btn-outline-yellow:hover {
    color: rgb(255, 255, 140);
    background-color: rgba(255, 255, 0, 0.06);
    border-color: rgb(255, 255, 0);
    text-shadow: 0 0 7px rgba(255, 255, 0, 0.45);
}

.btn-outline-yellow:active {
    translate: 2px -1px;
    color: rgb(255, 0, 255);
    background-color: transparent;
    border-color: rgb(255, 0, 255);
}

.btn-outline-muted {
    color: rgb(156, 163, 175);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(156, 163, 175, 0.45);
    height: 32px;
    font-size: 11px;
    padding-left: 14px;
    padding-right: 14px;
    text-shadow: none;
}

.btn-outline-muted:hover {
    color: rgb(180, 255, 255);
    background-color: rgba(0, 255, 255, 0.05);
    border-color: rgba(0, 255, 255, 0.7);
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.35);
}

.btn-outline-muted:active {
    translate: 2px -1px;
    color: rgb(255, 0, 255);
    background-color: transparent;
    border-color: rgb(255, 0, 255);
}

/* Home CTA 颜色压过 .btn-jack / .btn-outline-magenta（NeonHoverGlow 仍依赖那些 class） */
.menu-btn.home-cta-primary {
    color: rgb(3, 16, 24);
    background-color: rgb(0, 255, 255);
    border-color: rgba(180, 255, 255, 0.85);
    text-shadow: 0 0 6px rgba(0, 255, 255, 0.3);
}

.menu-btn.home-cta-primary:hover {
    color: rgb(3, 16, 24);
    background-color: rgb(184, 255, 255);
    border-color: rgb(200, 255, 255);
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.45);
}

.menu-btn.home-cta-primary:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    background-color: rgb(0, 255, 255);
    border-color: var(--neon-fuchsia);
}

.menu-btn.home-cta-magenta {
    color: rgb(255, 255, 255);
    background-color: rgb(36, 8, 28);
    border-color: rgba(255, 0, 200, 0.85);
    text-shadow: 0 0 5px rgba(255, 0, 200, 0.3);
}

.menu-btn.home-cta-magenta:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(56, 12, 42);
    border-color: rgb(255, 80, 220);
    text-shadow: 0 0 7px rgba(255, 0, 200, 0.45);
}

.menu-btn.home-cta-magenta:active {
    translate: 2px -1px;
    color: var(--neon-cyan);
    background-color: rgb(36, 8, 28);
    border-color: var(--neon-cyan);
}

.menu-btn.home-ghost {
    color: var(--neon-cyan);
    background-color: rgb(0, 20, 36);
    border-color: rgba(0, 255, 255, 0.4);
    text-shadow: none;
}

.menu-btn.home-ghost:hover {
    color: rgb(160, 255, 255);
    border-color: var(--neon-cyan);
    background-color: rgb(0, 28, 48);
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.3);
}

.menu-btn.home-ghost:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    border-color: var(--neon-fuchsia);
}

.menu-btn.home-quiet {
    color: var(--neon-muted);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(156, 163, 175, 0.28);
    text-shadow: none;
}

.menu-btn.home-quiet:hover {
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(0, 0, 0, 0);
    text-shadow: none;
}

.menu-btn.home-quiet:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    border-color: var(--neon-fuchsia);
}

.menu-btn.home-nav-link {
    color: var(--neon-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    text-shadow: none;
}

.menu-btn.home-nav-link:hover {
    color: var(--neon-cyan);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    text-shadow: 0 0 6px rgba(0, 255, 255, 0.4);
}

.menu-btn.home-nav-link:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
}

.header-title {
    font-size: 40px;
    color: rgb(255, 0, 128);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 0, 128, 0.5);
}

.back-btn {
    font-size: 23px;
    color: white;
    background-color: transparent;
    border-width: 0;
    transition: color 0.2s;
}

.back-btn:hover {
    color: rgb(0, 240, 255);
}

.level-scroll {
    flex-grow: 1;
    margin-top: 40px;
}

.detail-stage {
    font-size: 23px;
    color: rgb(0, 240, 255);
    margin-top: 13px;
    -unity-font-style: bold;
}

.detail-title {
    font-size: 47px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.divider {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 27px;
}

.detail-desc {
    font-size: 21px;
    color: rgb(200, 210, 220);
    white-space: normal;
    flex-grow: 1;
    -unity-text-align: upper-left;
}

.detail-info {
    font-size: 23px;
    color: white;
    margin-bottom: 13px;
}

.highlight-info {
    color: rgb(255, 0, 128);
    -unity-font-style: bold;
}

.launch-btn {
    height: 80px;
    font-size: 33px;
    -unity-font-style: bold;
    color: rgb(255, 245, 0);
    background-color: rgba(255, 245, 0, 0.15);
    border-width: 3px;
    border-color: rgb(255, 245, 0);
    border-radius: 10px;
    margin-top: 27px;
    transition: background-color 0.15s, border-color 0.15s;
}

.launch-btn:hover {
    background-color: rgba(255, 245, 0, 0.4);
    border-color: rgb(255, 255, 180);
}

/* 鍗＄墖鏍峰紡 */
.level-card {
    width: 293px;
    height: 427px;
    margin-right: 40px;
    background-color: rgba(30, 45, 70, 0.85); /* 璋冧寒鍗＄墖搴曡壊 */
    border-width: 2px;
    border-color: rgba(0, 240, 255, 0.3);
    border-radius: 13px;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, background-color 0.2s;
    overflow: hidden;
}

.level-card:hover {
    border-color: rgb(0, 240, 255);
    background-color: rgba(45, 65, 100, 0.95);
}

.card-deco {
    position: absolute;
    top: 0;
    width: 100%;
    height: 10px;
    background-color: rgb(0, 240, 255);
}

.card-num {
    font-size: 23px;
    color: rgb(0, 240, 255);
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.card-name {
    font-size: 37px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 27px;
}

.card-stars {
    font-size: 27px;
    color: rgb(255, 245, 0);
    -unity-font-style: bold;
}

.loadout-btn {
    color: rgb(220, 230, 255);
    border-color: rgb(160, 175, 210);
}

.run-config-summary {
    margin-top: 24px;
    padding: 16px;
    background-color: rgba(15, 25, 45, 0.85);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.35);
    border-radius: 8px;
}

.summary-header {
    font-size: 19px;
    color: rgb(0, 240, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.summary-line {
    font-size: 17px;
    color: rgb(210, 220, 235);
    margin-bottom: 5px;
}

.summary-edit-btn {
    margin-top: 8px;
    height: 37px;
    font-size: 17px;
    color: rgb(0, 240, 255);
    background-color: rgba(0, 240, 255, 0.08);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.45);
    border-radius: 5px;
}

/* ── 战前配置 · 复用主菜单 Terminal / 字雨背景 ── */
.loadout-panel {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px 56px;
    position: relative;
    background-color: rgba(2, 6, 14, 0.28);
}

.loadout-stage {
    width: 94%;
    max-width: 1680px;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.loadout-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 36px;
    padding: 16px 28px;
}

.loadout-header-center {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
}

.loadout-back-btn {
    min-width: 96px;
    height: 44px;
    margin-right: 8px;
    font-size: 20px;
    letter-spacing: 2px;
}

.loadout-sys {
    min-width: 110px;
    -unity-text-align: middle-right;
}

.loadout-title {
    font-size: 36px;
    color: rgba(140, 230, 255, 0.9);
    -unity-font-style: bold;
    letter-spacing: 10px;
    text-shadow: 0 0 16px rgba(0, 200, 255, 0.4);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.loadout-title-en {
    font-size: 14px;
    color: var(--neon-cyan);
    letter-spacing: 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    -unity-text-align: middle-center;
    text-shadow: 0 0 12px rgba(0, 232, 255, 0.4);
}

.loadout-body {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 560px;
    height: 580px;
    align-items: stretch;
    padding-left: 16px;
    padding-right: 16px;
}

.loadout-rail {
    flex-direction: column;
    min-height: 0;
    flex-shrink: 0;
}

.loadout-rail-left {
    width: 22%;
    max-width: 320px;
    min-width: 220px;
    padding-right: 40px;
    margin-right: 12px;
    border-right-width: 1px;
    border-right-color: rgba(0, 232, 255, 0.16);
}

.loadout-rail-right {
    width: 24%;
    max-width: 380px;
    min-width: 240px;
    padding-left: 40px;
    margin-left: 12px;
    border-left-width: 1px;
    border-left-color: rgba(0, 232, 255, 0.16);
}

.loadout-hero {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding-left: 48px;
    padding-right: 48px;
}

.column-title {
    font-size: 16px;
    color: var(--neon-cyan);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 22px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.column-title-center {
    -unity-text-align: middle-center;
    align-self: stretch;
}

.ball-thumb-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 18px;
}

.ball-thumb-list {
    flex-direction: column;
    align-items: stretch;
}

.ball-thumb {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    margin-bottom: 16px;
    padding: 12px 16px;
    background-color: rgba(4, 10, 22, 0.42);
    border-width: 1px;
    border-color: rgba(0, 232, 255, 0.2);
}

.ball-thumb:active {
    translate: 2px -1px;
    border-color: var(--neon-fuchsia);
}

.ball-thumb-active {
    border-color: var(--neon-cyan);
    background-color: rgba(0, 232, 255, 0.1);
}

.ball-thumb-equipped {
    border-color: rgba(255, 214, 96, 0.55);
}

.ball-thumb-locked {
    opacity: 0.45;
}

.ball-thumb-orb {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    margin-right: 12px;
    flex-shrink: 0;
    background-color: var(--neon-cyan);
}

.ball-thumb-name {
    flex-grow: 1;
    font-size: 17px;
    color: var(--neon-text);
    -unity-font-style: bold;
    white-space: nowrap;
}

.ball-thumb-mark {
    font-size: 12px;
    color: var(--neon-yellow);
    letter-spacing: 1px;
    margin-left: 6px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.ball-preview-host {
    width: 100%;
    max-width: 400px;
    height: 200px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-bottom: 20px;
    flex-shrink: 0;
}

.ball-preview-orb {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    background-color: var(--neon-cyan);
    border-width: 2px;
    border-color: rgba(200, 245, 255, 0.6);
}

.ball-preview-locked {
    opacity: 0.4;
}

.ball-pager-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 6px;
}

.ball-pager-dots {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.ball-pager-dot {
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ball-pager-dot-core {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.28);
}

.ball-pager-dot-active > .ball-pager-dot-core {
    background-color: var(--neon-cyan);
    width: 12px;
    height: 12px;
    border-radius: 6px;
}

.ball-pager-dot-equipped > .ball-pager-dot-core {
    background-color: var(--neon-yellow);
}

.ball-pager-dot-locked > .ball-pager-dot-core {
    background-color: rgba(255, 72, 96, 0.55);
}

.ball-nav-btn {
    width: 48px;
    height: 48px;
    min-width: 48px;
    font-size: 28px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgba(4, 10, 22, 0.45);
    border-width: 1px;
    border-color: var(--neon-border-strong);
    color: var(--neon-cyan);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
}

.ball-nav-btn:hover {
    border-color: var(--neon-cyan);
    background-color: rgba(0, 232, 255, 0.1);
}

.ball-nav-btn:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    border-color: var(--neon-fuchsia);
}

.ball-lock-hint {
    font-size: 16px;
    color: var(--neon-red);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.ball-name-label {
    font-size: 38px;
    color: var(--neon-ice);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 18px rgba(0, 232, 255, 0.45);
}

.ball-role-label {
    font-size: 13px;
    color: rgba(0, 232, 255, 0.65);
    letter-spacing: 5px;
    margin-bottom: 16px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgba(0, 232, 255, 0.35);
}

.ball-desc-label {
    font-size: 17px;
    color: rgba(170, 220, 240, 0.72);
    white-space: normal;
    margin-bottom: 28px;
    max-width: 420px;
    -unity-text-align: middle-center;
}

.hangar-equip-btn {
    height: 56px;
    min-width: 220px;
    padding-left: 28px;
    padding-right: 28px;
    font-size: 18px;
    letter-spacing: 3px;
    align-self: center;
    margin-right: 0;
}

.hangar-equip-btn:disabled {
    opacity: 1;
}

.skill-slot-stack {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    justify-content: flex-start;
    padding-top: 4px;
}

.skill-entry {
    flex-direction: row;
    flex-shrink: 0;
    align-items: stretch;
    margin-bottom: 36px;
    padding: 4px 0 12px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 232, 255, 0.12);
    min-height: 0;
}

.skill-slot-readonly {
    opacity: 1;
}

.skill-slot-empty {
    opacity: 0.55;
}

.skill-slot-empty > .skill-entry-rail {
    background-color: rgba(0, 232, 255, 0.25);
}

.skill-slot-locked > .skill-entry-rail {
    background-color: var(--neon-cyan);
}

.skill-entry-rail {
    width: 3px;
    min-width: 3px;
    margin-right: 16px;
    flex-shrink: 0;
    background-color: var(--neon-fuchsia);
    align-self: stretch;
}

.skill-entry-body {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    justify-content: center;
}

.skill-entry-code {
    font-size: 12px;
    color: rgba(0, 232, 255, 0.7);
    letter-spacing: 2px;
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
    text-shadow: 0 0 8px rgba(0, 232, 255, 0.25);
}

.skill-entry-name {
    font-size: 24px;
    color: var(--neon-ice);
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
    text-shadow: 0 0 12px rgba(0, 232, 255, 0.28);
}

.skill-entry-meta {
    flex-direction: row;
    align-items: center;
}

.skill-entry-cd {
    font-size: 15px;
    color: rgba(170, 220, 240, 0.62);
}

.skill-entry-dot {
    font-size: 15px;
    color: rgba(110, 140, 158, 0.7);
    margin-left: 10px;
    margin-right: 10px;
}

.skill-entry-mode {
    font-size: 15px;
    color: rgba(170, 220, 240, 0.62);
}

.loadout-skill-note {
    font-size: 13px;
    color: rgba(110, 140, 158, 0.85);
    margin-top: 8px;
    letter-spacing: 1px;
    white-space: normal;
    flex-shrink: 0;
}

.loadout-footer {
    flex-shrink: 0;
    margin-top: 40px;
    padding-top: 28px;
    padding-left: 16px;
    padding-right: 16px;
    border-top-width: 1px;
    border-top-color: rgba(0, 232, 255, 0.16);
}

.loadout-footer-title {
    margin-bottom: 18px;
}

.flipper-weapon-list {
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
}

.flipper-weapon-card {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 104px;
    min-width: 0;
    margin-right: 22px;
    padding: 18px 22px;
    background-color: rgba(4, 10, 22, 0.42);
    border-width: 1px;
    border-color: rgba(0, 232, 255, 0.22);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
}

.flipper-weapon-card-last {
    margin-right: 0;
}

.flipper-weapon-card:active {
    translate: 2px -1px;
    border-color: var(--neon-fuchsia);
}

.flipper-weapon-card-selected {
    border-color: var(--neon-yellow);
    background-color: rgba(255, 214, 96, 0.08);
}

.flipper-weapon-swatch {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.flipper-weapon-copy {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    margin-bottom: 8px;
}

.flipper-weapon-name {
    font-size: 20px;
    color: var(--neon-text);
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: nowrap;
}

.flipper-weapon-desc {
    font-size: 14px;
    color: rgba(170, 220, 240, 0.65);
    margin-top: 6px;
    white-space: normal;
}

.flipper-weapon-state {
    font-size: 13px;
    color: var(--neon-yellow);
    letter-spacing: 2px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

/* ── 协议商店 ── */
.shop-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 36px 48px;
    width: 92%;
    max-width: 1100px;
    align-self: center;
    background-color: rgba(10, 10, 15, 0.94);
}

.shop-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.shop-title {
    font-size: 40px;
    color: var(--neon-yellow);
    -unity-font-style: bold;
    letter-spacing: 8px;
    text-shadow: 0 0 10px rgba(255, 255, 0, 0.4);
}

.shop-credits-label {
    font-size: 20px;
    color: var(--neon-yellow);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.shop-tabs {
    flex-direction: row;
    margin-bottom: 14px;
    flex-shrink: 0;
}

.shop-tab {
    height: 52px;
    min-width: 160px;
    margin-right: 12px;
    font-size: 18px;
    letter-spacing: 2px;
    background-color: var(--neon-panel);
    color: var(--neon-muted);
    border-width: 1px;
    border-color: rgba(156, 163, 175, 0.35);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
}

.shop-tab-active {
    color: var(--neon-cyan);
    border-color: var(--neon-cyan);
    background-color: rgba(0, 255, 255, 0.08);
}

.shop-tab-content {
    flex-grow: 1;
    min-height: 0;
}

.shop-scroll {
    flex-grow: 1;
}

.shop-offer-list {
    flex-direction: column;
}

.shop-offer-row {
    flex-direction: row;
    align-items: center;
    padding: 18px 20px;
    margin-bottom: 12px;
    background-color: var(--neon-panel);
    border-width: 1px;
    border-color: var(--neon-border);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
}

.shop-offer-row:hover {
    border-color: var(--neon-cyan);
    background-color: var(--neon-panel-elevated);
}

.shop-offer-orb {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-right: 18px;
    flex-shrink: 0;
}

.shop-offer-info {
    flex-grow: 1;
}

.shop-offer-name {
    font-size: 24px;
    color: var(--neon-text);
    -unity-font-style: bold;
}

.shop-offer-desc {
    font-size: 16px;
    color: var(--neon-muted);
    white-space: normal;
    margin-top: 6px;
}

.shop-buy-btn {
    min-width: 120px;
    height: 48px;
    font-size: 17px;
    letter-spacing: 2px;
    color: rgb(0, 0, 0);
    background-color: var(--neon-yellow);
    border-width: 1px;
    border-color: var(--neon-yellow);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
}

.shop-buy-btn:hover {
    background-color: rgb(255, 255, 120);
}

.shop-buy-btn:active {
    translate: 2px -1px;
    color: var(--neon-fuchsia);
    background-color: transparent;
    border-color: var(--neon-fuchsia);
}

.shop-owned-label {
    font-size: 18px;
    color: var(--neon-green);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.shop-empty-label {
    font-size: 18px;
    color: var(--neon-muted);
    margin-top: 24px;
}

.crate-card {
    padding: 32px;
    background-color: var(--neon-panel);
    border-width: 1px;
    border-color: rgba(255, 255, 0, 0.35);
    border-radius: var(--neon-radius);
    max-width: 560px;
    align-items: stretch;
}

.crate-eyebrow {
    font-size: 13px;
    color: rgba(255, 255, 0, 0.7);
    letter-spacing: 3px;
    margin-bottom: 4px;
}

.crate-title {
    font-size: 32px;
    color: var(--neon-yellow);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
    text-shadow: 0 0 8px rgba(255, 255, 0, 0.35);
}

.crate-desc {
    font-size: 17px;
    color: var(--neon-muted);
    white-space: normal;
    margin-bottom: 14px;
}

.crate-preview {
    height: 160px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    overflow: visible;
}

.crate-glow-ring {
    position: absolute;
    width: 128px;
    height: 128px;
    border-radius: 64px;
    border-width: 1px;
    border-color: rgba(255, 255, 0, 0.35);
    background-color: rgba(255, 255, 0, 0.04);
}

.crate-body-idle {
    width: 96px;
    height: 74px;
    background-color: rgb(8, 14, 28);
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.55);
    border-radius: 4px;
    align-items: center;
    justify-content: flex-start;
    overflow: visible;
}

.crate-lid-idle {
    width: 100px;
    height: 18px;
    margin-top: -8px;
    background-color: rgb(12, 20, 40);
    border-width: 1px;
    border-color: rgba(255, 0, 255, 0.55);
    border-radius: 3px;
}

.crate-seal-idle {
    width: 24px;
    height: 24px;
    margin-top: 12px;
    border-radius: 12px;
    background-color: rgb(255, 255, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 0, 0.9);
}

.crate-cost {
    font-size: 20px;
    color: var(--neon-cyan);
    margin-bottom: 6px;
}

.crate-pity {
    font-size: 16px;
    color: var(--neon-muted);
    margin-bottom: 14px;
}

.crate-open-btn {
    height: 56px;
    font-size: 20px;
    letter-spacing: 2px;
    margin-bottom: 8px;
    color: var(--neon-text);
    background-color: rgba(255, 0, 255, 0.15);
    border-width: 1px;
    border-color: var(--neon-fuchsia);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
    text-shadow: 0 0 6px rgba(255, 0, 255, 0.35);
}

.crate-open-btn:hover {
    background-color: rgba(255, 0, 255, 0.28);
}

.crate-open-btn:active {
    translate: 2px -1px;
}

.crate-disabled {
    opacity: 0.45;
}

/* ── 开箱仪式 · 皇室战争式全屏聚光 ── */
.crate-result-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 4, 10, 0.88);
    overflow: visible;
}

.crate-vignette-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.crate-ray-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.crate-screen-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    opacity: 0;
}

.crate-light-pillar {
    position: absolute;
    width: 220px;
    height: 48%;
    align-self: center;
    top: 8%;
    background-color: rgba(255, 245, 200, 0.12);
    opacity: 0;
    border-radius: 110px;
}

.crate-spark-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: visible;
}

.crate-ui-spark {
    position: absolute;
    border-radius: 3px;
    background-color: rgb(255, 255, 120);
}

.crate-ritual-stage {
    width: 100%;
    height: 100%;
    max-width: none;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.crate-ritual-status {
    position: absolute;
    top: 12%;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.crate-assembly {
    width: 240px;
    height: 220px;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 0;
    overflow: visible;
}

.crate-ground-shadow {
    position: absolute;
    bottom: 8px;
    width: 160px;
    height: 22px;
    border-radius: 80px;
    background-color: rgba(0, 0, 0, 0.45);
}

.crate-glow {
    position: absolute;
    bottom: 28px;
    width: 180px;
    height: 180px;
    border-radius: 90px;
    background-color: rgba(255, 220, 80, 0.06);
    border-width: 1px;
    border-color: rgba(255, 220, 80, 0.25);
    opacity: 0.35;
}

.crate-stack {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: visible;
    margin-bottom: 18px;
}

.crate-lid {
    width: 132px;
    height: 36px;
    margin-bottom: -6px;
    align-items: center;
    justify-content: center;
    overflow: visible;
    transform-origin: 50% 100%;
}

.crate-lid-face {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(18, 28, 52);
    border-width: 2px;
    border-color: rgb(255, 210, 60);
    border-radius: 6px 6px 2px 2px;
}

.crate-lid-band {
    position: absolute;
    width: 100%;
    height: 8px;
    top: 14px;
    background-color: rgba(255, 210, 60, 0.85);
}

.crate-body {
    width: 128px;
    height: 96px;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.crate-body-face {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(12, 20, 38);
    border-width: 2px;
    border-color: rgb(0, 200, 220);
    border-radius: 4px;
}

.crate-body-band {
    position: absolute;
    width: 100%;
    height: 14px;
    top: 38px;
    background-color: rgba(0, 200, 220, 0.75);
}

.crate-seal {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgb(255, 220, 60);
    border-width: 2px;
    border-color: rgb(255, 255, 180);
    margin-top: 8px;
}

.crate-core {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(255, 255, 220, 0.55);
    opacity: 0;
}

.crate-reveal-block {
    position: absolute;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.crate-reveal-card {
    width: 280px;
    padding: 22px 20px 18px;
    align-items: center;
    background-color: rgba(3, 7, 18, 0.92);
    border-width: 1px;
    border-color: rgba(255, 210, 60, 0.45);
    border-radius: var(--neon-radius);
}

.crate-rarity-label {
    font-size: 13px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.crate-rarity-rare {
    color: rgb(0, 255, 255);
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.55);
}

.crate-rarity-epic {
    color: rgb(255, 0, 255);
    text-shadow: 0 0 12px rgba(255, 0, 255, 0.6);
}

.crate-rarity-legendary {
    color: rgb(255, 255, 0);
    text-shadow: 0 0 12px rgba(255, 255, 0, 0.6);
}

.crate-reveal-orb {
    width: 88px;
    height: 88px;
    border-radius: 44px;
    margin-bottom: 14px;
    background-color: rgb(0, 255, 255);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.75);
}

.crate-result-title {
    font-size: 24px;
    color: var(--neon-yellow);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgba(255, 255, 0, 0.45);
}

.crate-result-body {
    font-size: 14px;
    color: var(--neon-muted);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 260px;
}

.crate-result-ok {
    position: absolute;
    bottom: 10%;
    height: 44px;
    min-width: 180px;
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    background-color: rgb(255, 220, 60);
    border-width: 1px;
    border-color: rgb(255, 240, 140);
    border-radius: var(--neon-radius);
    transition-duration: var(--neon-fast);
}

.crate-result-ok:hover {
    background-color: rgb(255, 240, 120);
}

.crate-result-ok:active {
    translate: 2px -1px;
    background-color: transparent;
    color: rgb(255, 220, 60);
}


/* ── 设置页 ── */
.settings-panel {
    flex-direction: column;
    align-items: stretch;
    padding: 22px 36px;
    max-width: 520px;
    align-self: center;
    background-color: rgba(10, 10, 15, 0.94);
}

.settings-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.settings-title {
    font-size: 24px;
    color: var(--neon-cyan);
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-left: 14px;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
}

.settings-scroll {
    flex-grow: 1;
}

.settings-section {
    font-size: 12px;
    color: var(--neon-cyan);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-top: 12px;
    margin-bottom: 8px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding: 6px 0;
}

.settings-label {
    font-size: 14px;
    color: var(--neon-muted);
    min-width: 90px;
}

.settings-slider {
    flex-grow: 1;
    max-width: 280px;
}

.settings-hint {
    font-size: 13px;
    color: var(--neon-muted);
    white-space: normal;
    margin-bottom: 8px;
}

.settings-stub-note {
    font-size: 12px;
    color: rgba(156, 163, 175, 0.65);
    margin-top: 14px;
}

/* ── 协议商店 · 克制的数字展厅 ── */
.shop-panel {
    width: 100%;
    height: 100%;
    max-width: none;
    align-self: stretch;
    align-items: stretch;
    padding: 24px 5.2% 30px;
    background-color: rgba(2, 7, 13, 0.96);
    overflow: hidden;
}

.shop-panel > .shop-header {
    height: 72px;
    min-height: 72px;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 0 4px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(57, 232, 255, 0.26);
}

.shop-back-btn {
    min-width: 112px;
    height: 42px;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    color: rgba(221, 247, 255, 0.78);
    background-color: rgba(5, 18, 29, 0.72);
    border-width: 1px;
    border-color: rgba(57, 232, 255, 0.26);
    border-radius: 2px;
    font-size: 15px;
    transition-duration: 0.14s;
}

.shop-back-btn:hover {
    color: rgb(221, 247, 255);
    border-color: rgba(57, 232, 255, 0.72);
    background-color: rgba(10, 40, 55, 0.8);
}

.shop-title-group {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-width: 0;
}

.shop-title {
    color: rgb(221, 247, 255);
    font-size: 30px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 7px rgba(57, 232, 255, 0.2);
}

.shop-subtitle {
    margin-top: 2px;
    color: rgba(143, 169, 184, 0.78);
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.shop-currency-chip {
    min-width: 176px;
    height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    background-color: rgba(7, 22, 34, 0.82);
    border-width: 1px;
    border-color: rgba(57, 232, 255, 0.36);
    border-radius: 2px;
}

.shop-currency-icon {
    margin-right: 10px;
    color: rgb(57, 232, 255);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.shop-credits-label {
    color: rgb(221, 247, 255);
    font-size: 16px;
    letter-spacing: 1px;
}

.shop-panel > .shop-tabs {
    min-height: 46px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 12px 0 10px;
}

.shop-tab {
    min-width: 172px;
    height: 42px;
    margin: 0 5px;
    padding: 0 18px;
    color: rgba(143, 169, 184, 0.82);
    background-color: rgba(4, 14, 23, 0.72);
    border-width: 1px;
    border-color: rgba(57, 232, 255, 0.18);
    border-radius: 2px;
    font-size: 15px;
    letter-spacing: 2px;
    transition-duration: 0.14s;
}

.shop-tab:hover {
    color: rgb(221, 247, 255);
    border-color: rgba(57, 232, 255, 0.48);
}

.shop-tab-active {
    color: rgb(221, 247, 255);
    background-color: rgba(15, 67, 86, 0.48);
    border-color: rgba(57, 232, 255, 0.86);
}

.shop-tab-content {
    min-height: 0;
}

.shop-direct-tab {
    flex-direction: column;
    flex-grow: 1;
}

.shop-direct-main {
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.shop-orb-stage {
    position: relative;
    min-width: 0;
    min-height: 300px;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgba(3, 12, 20, 0.28);
    border-right-width: 1px;
    border-right-color: rgba(57, 232, 255, 0.13);
}

.shop-orbit {
    position: absolute;
    align-self: center;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgba(57, 232, 255, 0.16);
}

.shop-orbit-outer {
    left: 18%;
    right: 18%;
    bottom: 15%;
    height: 74px;
}

.shop-orbit-inner {
    left: 25%;
    right: 25%;
    bottom: 18%;
    height: 46px;
    border-color: rgba(57, 232, 255, 0.3);
}

.shop-direct-orb {
    width: 220px;
    height: 220px;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 8, 14, 0.94);
    border-width: 2px;
    border-color: rgba(57, 232, 255, 0.92);
    border-radius: 110px;
}

.shop-direct-orb-core {
    width: 154px;
    height: 154px;
    border-width: 1px;
    border-color: rgba(221, 247, 255, 0.6);
    border-radius: 77px;
}

.shop-direct-orb-glint {
    position: absolute;
    left: 26%;
    top: 23%;
    width: 11px;
    height: 11px;
    background-color: rgba(221, 247, 255, 0.86);
    border-radius: 6px;
}

.shop-orbit-tick {
    position: absolute;
    bottom: 26%;
    width: 20px;
    height: 2px;
    background-color: rgba(57, 232, 255, 0.72);
}

.shop-orbit-tick-left {
    left: 14%;
}

.shop-orbit-tick-right {
    right: 14%;
}

.shop-stage-caption {
    position: absolute;
    right: 18px;
    bottom: 14px;
    color: rgba(143, 169, 184, 0.68);
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.shop-product-info {
    width: 38%;
    min-width: 280px;
    max-width: 470px;
    flex-shrink: 0;
    justify-content: center;
    padding: 22px 0 22px 42px;
}

.shop-eyebrow,
.shop-price-caption {
    color: rgba(143, 169, 184, 0.72);
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.shop-product-rarity {
    margin-top: 12px;
    color: rgb(57, 232, 255);
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Bold.ttf");
}

.shop-product-name {
    margin-top: 8px;
    color: rgb(221, 247, 255);
    font-size: 32px;
    -unity-font-style: bold;
}

.shop-product-description {
    max-width: 420px;
    margin-top: 12px;
    color: rgba(185, 207, 219, 0.82);
    font-size: 16px;
    white-space: normal;
}

.shop-product-divider {
    height: 1px;
    margin: 22px 0 16px;
    background-color: rgba(57, 232, 255, 0.2);
}

.shop-product-state {
    color: rgb(57, 232, 255);
    font-size: 13px;
    letter-spacing: 1px;
}

.shop-product-state-owned {
    color: rgba(185, 207, 219, 0.78);
}

.shop-product-state-unavailable {
    color: rgb(185, 126, 230);
}

.shop-price-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
}

.shop-product-price {
    color: rgb(221, 247, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

.shop-primary-action {
    height: 50px;
    margin-top: 20px;
    color: rgb(221, 247, 255);
    background-color: rgba(15, 89, 112, 0.62);
    border-width: 1px;
    border-color: rgba(57, 232, 255, 0.88);
    border-radius: 2px;
    font-size: 16px;
    letter-spacing: 2px;
    transition-duration: 0.14s;
}

.shop-primary-action:hover {
    background-color: rgba(20, 112, 137, 0.78);
}

.shop-primary-action:active {
    translate: 2px -1px;
    color: rgb(2, 7, 13);
    background-color: rgb(57, 232, 255);
}

.shop-primary-action:disabled {
    color: rgba(143, 169, 184, 0.62);
    background-color: rgba(7, 19, 28, 0.72);
    border-color: rgba(143, 169, 184, 0.22);
}

.shop-carousel-shell {
    height: 142px;
    min-height: 142px;
    flex-shrink: 0;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(57, 232, 255, 0.2);
}

.shop-carousel-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.shop-carousel-title {
    color: rgb(221, 247, 255);
    font-size: 13px;
    letter-spacing: 2px;
}

.shop-carousel-hint {
    margin-left: 14px;
    color: rgba(143, 169, 184, 0.64);
    font-size: 11px;
}

.shop-scroll {
    min-height: 0;
    flex-grow: 1;
}

.shop-offer-list {
    flex-direction: row;
    align-items: stretch;
}

.shop-ball-option {
    width: 204px;
    min-width: 204px;
    height: 78px;
    flex-direction: row;
    align-items: center;
    margin: 0 10px 0 0;
    padding: 10px 12px;
    background-color: rgba(4, 14, 23, 0.76);
    border-width: 1px;
    border-color: rgba(57, 232, 255, 0.19);
    border-radius: 2px;
    transition-duration: 0.14s;
}

.shop-ball-option:hover {
    background-color: rgba(8, 28, 40, 0.92);
    border-color: rgba(57, 232, 255, 0.5);
}

.shop-ball-option-selected {
    background-color: rgba(9, 38, 51, 0.94);
    border-color: rgba(57, 232, 255, 0.92);
}

.shop-ball-option-owned {
    opacity: 0.66;
}

.shop-offer-orb {
    width: 46px;
    min-width: 46px;
    height: 46px;
    margin-right: 12px;
    border-radius: 23px;
    border-width: 1px;
    border-color: rgba(221, 247, 255, 0.42);
}

.shop-offer-info {
    min-width: 0;
    flex-grow: 1;
}

.shop-offer-name {
    color: rgb(221, 247, 255);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.shop-offer-state {
    margin-top: 5px;
    color: rgba(57, 232, 255, 0.82);
    font-size: 11px;
}

.shop-offer-state-owned {
    color: rgba(185, 207, 219, 0.72);
}

.shop-empty-label {
    align-self: center;
    margin: 18px;
    color: rgba(143, 169, 184, 0.76);
    font-size: 14px;
}

/* 宝箱信息页：保留现有仪式逻辑，减少静态页面装饰 */
.shop-crate-tab {
    flex-grow: 1;
    min-height: 0;
}

.shop-crate-layout {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    min-height: 0;
}

.shop-crate-stage {
    min-width: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 20px 5%;
    border-right-width: 1px;
    border-right-color: rgba(57, 232, 255, 0.18);
}

.shop-panel .crate-eyebrow {
    margin-bottom: 10px;
    color: rgba(143, 169, 184, 0.72);
    font-size: 10px;
    letter-spacing: 3px;
}

.shop-panel .crate-preview {
    position: relative;
    width: 100%;
    max-width: 560px;
    height: 280px;
    margin: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.shop-panel .crate-glow-ring {
    width: 190px;
    height: 190px;
    border-radius: 95px;
    border-color: rgba(57, 232, 255, 0.22);
    background-color: rgba(57, 232, 255, 0.025);
}

.shop-panel .crate-body-idle {
    width: 154px;
    height: 110px;
    align-items: center;
    background-color: rgb(5, 16, 25);
    border-color: rgba(57, 232, 255, 0.72);
    border-radius: 2px;
}

.shop-panel .crate-lid-idle {
    width: 162px;
    height: 18px;
    margin-top: -8px;
    background-color: rgb(7, 24, 36);
    border-color: rgba(57, 232, 255, 0.72);
    border-radius: 2px;
}

.shop-panel .crate-seal-idle {
    width: 28px;
    height: 28px;
    margin-top: 26px;
    background-color: rgba(57, 232, 255, 0.16);
    border-color: rgba(57, 232, 255, 0.9);
    border-radius: 14px;
}

.shop-panel .crate-title {
    margin-top: 4px;
    margin-bottom: 6px;
    color: rgb(221, 247, 255);
    font-size: 28px;
    letter-spacing: 2px;
    text-shadow: 0 0 6px rgba(57, 232, 255, 0.16);
}

.shop-panel .crate-desc {
    max-width: 440px;
    margin: 0;
    color: rgba(185, 207, 219, 0.78);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.shop-crate-info {
    width: 40%;
    min-width: 300px;
    max-width: 480px;
    flex-shrink: 0;
    justify-content: center;
    padding: 24px 0 24px 40px;
}

.shop-crate-heading {
    margin-bottom: 18px;
    color: rgb(221, 247, 255);
    font-size: 22px;
    -unity-font-style: bold;
}

.shop-panel .crate-cost {
    margin-bottom: 20px;
    color: rgb(57, 232, 255);
    font-size: 20px;
}

.crate-pity-block {
    padding: 14px 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(57, 232, 255, 0.2);
    border-bottom-color: rgba(57, 232, 255, 0.2);
}

.crate-pity-heading {
    flex-direction: column;
    margin-bottom: 10px;
}

.crate-pity-caption {
    margin-bottom: 6px;
    color: rgb(221, 247, 255);
    font-size: 13px;
}

.shop-panel .crate-pity {
    margin: 0;
    color: rgba(143, 169, 184, 0.86);
    font-size: 12px;
}

.crate-pity-track {
    height: 5px;
    overflow: hidden;
    background-color: rgba(143, 169, 184, 0.16);
    border-radius: 3px;
}

.crate-pity-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(57, 232, 255);
    border-radius: 3px;
}

.shop-panel .crate-open-btn {
    height: 50px;
    margin: 20px 0 0;
    color: rgb(221, 247, 255);
    background-color: rgba(15, 89, 112, 0.62);
    border-color: rgba(57, 232, 255, 0.88);
    border-radius: 2px;
    font-size: 16px;
    letter-spacing: 2px;
    text-shadow: none;
    transition-duration: 0.14s;
}

.shop-panel .crate-open-btn:hover {
    background-color: rgba(20, 112, 137, 0.78);
}

.shop-panel .crate-open-btn:active {
    translate: 2px -1px;
}

.shop-panel .crate-open-btn:disabled {
    opacity: 0.42;
}

.shop-crate-footnote {
    margin-top: 10px;
    color: rgba(143, 169, 184, 0.66);
    font-size: 11px;
    white-space: normal;
}

.shop-panel .crate-result-popup {
    background-color: rgba(2, 7, 13, 0.95);
}

.shop-panel .crate-light-pillar {
    background-color: rgba(57, 232, 255, 0.07);
}

.shop-panel .crate-glow {
    background-color: rgba(57, 232, 255, 0.035);
    border-color: rgba(57, 232, 255, 0.2);
}

.shop-panel .crate-lid-face,
.shop-panel .crate-body-face {
    border-color: rgba(57, 232, 255, 0.78);
}

.shop-panel .crate-lid-band,
.shop-panel .crate-body-band {
    background-color: rgba(57, 232, 255, 0.52);
}

.shop-panel .crate-seal {
    background-color: rgb(57, 232, 255);
    border-color: rgb(221, 247, 255);
}

.shop-panel .crate-core {
    background-color: rgba(144, 239, 255, 0.68);
}

.shop-panel .crate-reveal-card {
    background-color: rgba(3, 12, 20, 0.96);
    border-color: rgba(57, 232, 255, 0.46);
}

.shop-panel .crate-rarity-rare {
    color: rgb(57, 232, 255);
    text-shadow: 0 0 6px rgba(57, 232, 255, 0.28);
}

.shop-panel .crate-rarity-epic {
    color: rgb(210, 128, 255);
    text-shadow: 0 0 6px rgba(190, 90, 255, 0.28);
}

.shop-panel .crate-rarity-legendary {
    color: rgb(180, 229, 255);
    text-shadow: 0 0 6px rgba(120, 210, 255, 0.28);
}

.shop-panel .crate-result-title {
    color: rgb(221, 247, 255);
    text-shadow: 0 0 6px rgba(57, 232, 255, 0.2);
}

.shop-panel .crate-result-ok {
    color: rgb(221, 247, 255);
    background-color: rgba(15, 89, 112, 0.62);
    border-color: rgba(57, 232, 255, 0.88);
    border-radius: 2px;
}

.shop-panel .crate-result-ok:hover {
    background-color: rgba(20, 112, 137, 0.78);
}

/* 竖屏商店：主预览、商品信息、商品列表按阅读顺序纵向排列 */
.shop-panel.shop-portrait {
    padding: 18px 22px 22px;
    background-color: rgb(2, 7, 13);
}

.shop-portrait > .shop-header {
    height: 92px;
    min-height: 92px;
    margin-bottom: 4px;
    padding: 0 0 10px;
}

.shop-portrait .shop-back-btn {
    min-width: 118px;
    height: 58px;
    font-size: 22px;
}

.shop-portrait .shop-title {
    font-size: 46px;
    letter-spacing: 2px;
}

.shop-portrait .shop-subtitle {
    font-size: 14px;
    letter-spacing: 2px;
}

.shop-portrait .shop-currency-chip {
    min-width: 208px;
    height: 58px;
    padding: 0 12px;
}

.shop-portrait .shop-currency-icon {
    margin-right: 7px;
    font-size: 16px;
}

.shop-portrait .shop-credits-label {
    font-size: 22px;
    letter-spacing: 0;
}

.shop-portrait > .shop-tabs {
    min-height: 76px;
    margin: 8px 0 12px;
}

.shop-portrait .shop-tab {
    min-width: 240px;
    height: 66px;
    margin: 0 8px;
    padding: 0 16px;
    font-size: 26px;
    letter-spacing: 1px;
}

.shop-portrait .shop-direct-main {
    flex-direction: column;
}

.shop-portrait .shop-orb-stage {
    min-height: 300px;
    flex-grow: 1;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(57, 232, 255, 0.16);
}

.shop-portrait .shop-direct-orb {
    width: 350px;
    height: 350px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.shop-portrait .shop-orbit-outer {
    left: 16%;
    right: 16%;
    bottom: 9%;
    height: 88px;
}

.shop-portrait .shop-orbit-inner {
    left: 25%;
    right: 25%;
    bottom: 11%;
    height: 54px;
}

.shop-portrait .shop-orbit-tick {
    bottom: 16%;
    width: 30px;
    height: 3px;
}

.shop-portrait .shop-stage-caption {
    right: 10px;
    bottom: 8px;
    font-size: 13px;
    letter-spacing: 2px;
}

.shop-portrait .shop-product-info {
    width: 100%;
    min-width: 0;
    max-width: none;
    flex-shrink: 0;
    padding: 18px 16px 20px;
}

.shop-portrait .shop-eyebrow,
.shop-portrait .shop-price-caption {
    font-size: 15px;
    letter-spacing: 2px;
}

.shop-portrait .shop-product-rarity {
    margin-top: 8px;
    font-size: 18px;
    letter-spacing: 2px;
}

.shop-portrait .shop-product-name {
    margin-top: 4px;
    font-size: 40px;
}

.shop-portrait .shop-product-description {
    max-width: none;
    margin-top: 6px;
    font-size: 25px;
}

.shop-portrait .shop-product-divider {
    margin: 12px 0 10px;
}

.shop-portrait .shop-product-state {
    font-size: 20px;
}

.shop-portrait .shop-price-row {
    margin-top: 4px;
}

.shop-portrait .shop-product-price {
    font-size: 34px;
}

.shop-portrait .shop-primary-action {
    height: 66px;
    margin-top: 12px;
    font-size: 25px;
}

.shop-portrait .shop-carousel-shell {
    height: 212px;
    min-height: 212px;
    padding-top: 12px;
}

.shop-portrait .shop-carousel-heading {
    margin-bottom: 10px;
}

.shop-portrait .shop-carousel-title {
    font-size: 22px;
    letter-spacing: 1px;
}

.shop-portrait .shop-carousel-hint {
    margin-left: 10px;
    font-size: 17px;
}

.shop-portrait .shop-ball-option {
    width: 264px;
    min-width: 264px;
    height: 132px;
    margin-right: 12px;
    padding: 10px 12px;
}

.shop-portrait .shop-offer-orb {
    width: 84px;
    min-width: 84px;
    height: 84px;
    margin-right: 10px;
    border-width: 0;
}

.shop-portrait .shop-offer-name {
    font-size: 23px;
    white-space: normal;
}

.shop-portrait .shop-offer-state {
    margin-top: 7px;
    font-size: 19px;
}

/* 宝箱在竖屏下采用同样的视觉层级 */
.shop-portrait .shop-crate-layout {
    flex-direction: column;
}

.shop-portrait .shop-crate-stage {
    min-height: 0;
    flex-grow: 1;
    padding: 12px 5%;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(57, 232, 255, 0.16);
}

.shop-panel.shop-portrait .crate-eyebrow {
    font-size: 14px;
}

.shop-panel.shop-portrait .crate-preview {
    height: 340px;
    flex-shrink: 1;
}

.shop-panel.shop-portrait .crate-title {
    font-size: 34px;
}

.shop-panel.shop-portrait .crate-desc {
    font-size: 19px;
}

.shop-portrait .shop-crate-info {
    width: 100%;
    min-width: 0;
    max-width: none;
    flex-shrink: 0;
    padding: 18px 18px 24px;
}

.shop-portrait .shop-crate-heading {
    margin-bottom: 12px;
    font-size: 28px;
}

.shop-panel.shop-portrait .crate-cost {
    margin-bottom: 14px;
    font-size: 23px;
}

.shop-portrait .crate-pity-caption {
    font-size: 19px;
}

.shop-panel.shop-portrait .crate-pity {
    font-size: 17px;
}

.shop-panel.shop-portrait .crate-open-btn {
    height: 66px;
    margin-top: 14px;
    font-size: 22px;
}

.shop-portrait .shop-crate-footnote {
    font-size: 15px;
}
